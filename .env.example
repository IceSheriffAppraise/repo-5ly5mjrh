# Supabase connection (single source of truth for all configurable data).
# Local dev: run `supabase start` and copy the printed values here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by API routes / admin to bypass RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
